CONFIG_MI_T1_CHIP=m
CONFIG_MCA_EXTERNAL_WIRELESS_SC96281=m
CONFIG_IR_SPI=m
CONFIG_LEDS_AW21024=m
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_MI_FP=m

CONFIG_MI_POWER_SAVE=m
CONFIG_MI_UNION_POWER=m
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m
CONFIG_PERF_HELPER=m

# Kernel-level baseband protection (Baseband-guard LSM)
CONFIG_BBG=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,bpf,baseband_guard"

# ADIOS I/O scheduler (loadable module; registered at modprobe time)
CONFIG_MQ_IOSCHED_ADIOS=m

# Full tmpfs support
CONFIG_TMPFS_INODE64=y
CONFIG_TMPFS_QUOTA=y

# Re:Kernel 11.7 notification-only integration (no async cleanup)
CONFIG_REKERNEL=y
CONFIG_NTSYNC=y

CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=m
CONFIG_NET_SCH_FQ=y

# ============================================================
# Custom additions (network / storage / power)
# ============================================================
# --- network ---
CONFIG_NET_SCH_CAKE=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_WIREGUARD=y
# --- storage / memory ---
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# --- usb tethering ---
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_NCM=y
# --- power ---
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_CPU_IDLE_GOV_TEO=y
# --- network extras ---
CONFIG_IP_SET=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_MPTCP=y
CONFIG_TLS=y
CONFIG_NET_SCH_FQ_PIE=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_CLS_U32=y
CONFIG_TCP_CONG_HTCP=y
CONFIG_TCP_CONG_VEGAS=y
CONFIG_TCP_CONG_ILLINOIS=y
# --- usb ---
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_MTP=y
CONFIG_USB_CONFIGFS_F_PTP=y
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
# --- misc / debug ---
CONFIG_INPUT_UINPUT=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_KALLSYMS_ALL=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
# --- 与原厂 struct module 布局对齐（module_layout CRC）---
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_PROTECT=y
CONFIG_MODULE_SIG_SHA1=y
CONFIG_MODULE_SIG_HASH="sha1"
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_MODULE_SIG_KEY_TYPE_RSA=y
CONFIG_MODULE_UNLOAD=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_MODULE_ALLOW_BTF_MISMATCH=y
CONFIG_MODULE_COMPRESS_NONE=y
CONFIG_ANDROID_KABI_RESERVE=y
CONFIG_TRACEPOINTS=y
CONFIG_STACKTRACE_BUILD_ID=y
CONFIG_JUMP_LABEL=y
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_MODULE_UNLOAD_TAINT_TRACKING is not set